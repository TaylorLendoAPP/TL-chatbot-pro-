name: tl_chatbot_pro
description: Chatbot Flutter intelligent avec mémoire, support vocal, génération d'images, support multilingue et génération de vidéos via API externe.
publish_to: 'none'

version: 1.0.0+1

environment:
  sdk: ">=3.1.0 <4.0.0"

dependencies:
  flutter:
    sdk: flutter

  cupertino_icons: ^1.0.2
  http: ^0.13.5
  provider: ^6.0.5
  flutter_tts: ^3.6.3
  speech_to_text: ^6.3.0
  image_picker: ^1.0.4
  path_provider: ^2.1.2
  intl: ^0.18.1
  flutter_localizations:
    sdk: flutter

dev_dependencies:
  flutter_test:
    sdk: flutter

flutter:
  uses-material-design: true
  assets:
    - assets/
